# База данных для api-gateway (чат)
CHAT_DB_USER=chat_user
CHAT_DB_PASSWORD=chat_pass
CHAT_DB_NAME=chat_db

# База данных для user-service
USER_DB_USER=user_user
USER_DB_PASSWORD=user_pass
USER_DB_NAME=users_db

# Redis
REDIS_URL=redis://redis:6379

# Секрет для JWT (обязательно измените на свой длинный ключ)
JWT_SECRET=my_super_secret_key_change_me_please_make_it_long_and_random

# Адрес user-service внутри Docker-сети
USER_SERVICE_URL=http://user-service:8001